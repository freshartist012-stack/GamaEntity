<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <application tools:ignore="AllowBackup">
        <activity
            android:name=".MainActivity"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll"/>
        </activity>
        <activity
            android:name=".ProMainActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.DayNight">
        </activity>
        <service
            android:name=".GamaAccessibilityService"
            android:exported="true"
            android:label="GAMA Pro Assistant"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>
        <service
            android:name=".ProOverlayService"
            android:exported="false"/>
        <activity
            android:name=".AssistantOverlayActivity"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.Dialog"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
